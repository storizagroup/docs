          },
          {
            "group": "App backups",
            "pages": [
              "GET /apps/{id}/backups",
              "POST /apps/{id}/backups",
              "DELETE /apps/{id}/backups/{backupId}",
              "GET /apps/{id}/backups/{backupId}/download",
              "GET /apps/{id}/restores",
              "POST /apps/{id}/restores"
            ]
          },
          {
            "group": "App domains",
            "pages": [
              "GET /apps/{id}/exposures",
              "POST /apps/{id}/exposures",
