{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Storiza Docs",
  "description": "Guides and API reference for Storiza: VPS servers, game servers, databases and bots.",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#173da6"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://storiza.store"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@storiza.store"
      },
      {
        "label": "Website",
        "href": "https://storiza.store"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.storiza.store"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Using the API",
            "pages": [
              "concepts/responses-and-errors",
              "concepts/pagination-and-filtering",
              "concepts/billing-and-payments"
            ]
          },
          {
            "group": "Servers & apps",
            "pages": [
              "guides/deploy-a-vps",
              "guides/deploy-an-app",
              "guides/app-files-and-console",
              "guides/realtime"
            ]
          },
          {
            "group": "More",
            "pages": [
              "guides/ai-agents",
              "guides/support"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Servers",
            "pages": [
              "GET /vps/",
              "GET /vps/{vmId}",
              "POST /vps/",
              "POST /vps/order",
              "POST /vps/{id}/renew",
              "POST /vps/{id}/upgrade"
            ]
          },
          {
            "group": "Server power & commands",
            "pages": [
              "POST /vps/{vmId}/start",
              "POST /vps/{vmId}/stop",
              "POST /vps/{vmId}/reboot",
              "POST /vps/{vmId}/kill",
              "GET /vps/{vmId}/status",
              "POST /vps/{vmId}/execute"
            ]
          },
          {
            "group": "Server settings",
            "pages": [
              "PUT /vps/{vmId}/info",
              "POST /vps/{vmId}/reinstall",
              "GET /vps/{vmId}/provision"
            ]
          },
          {
            "group": "Server firewall",
            "pages": [
