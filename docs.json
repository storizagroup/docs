            "group": "App catalog",
            "pages": [
              "GET /apps-templates/",
              "GET /apps-plans/",
              "GET /apps-nodes/"
            ]
          },
          {
            "group": "Subscriptions",
            "pages": [
              "GET /payments/subscriptions",
              "GET /payments/subscriptions/{id}",
              "PATCH /payments/subscriptions/{id}/period",
              "DELETE /payments/subscriptions/{id}",
              "POST /payments/subscriptions/{id}",
              "GET /payments/subscriptions/{id}/manage"
